# Environment variables for local development
# Copy this file to .env.dev and fill in values
# Only keys used by the Tiltfile are required (SA_PASSWORD, RABBITMQ_DEFAULT_PASS, ConnectionStrings)

# MSSQL SA password (used by mssql pod and connection string)
SA_PASSWORD=YourStrong@Passw0rd

# RabbitMQ credentials (used by rabbitmq pod RABBITMQ_DEFAULT_PASS env var)
RABBITMQ_DEFAULT_PASS=guest

# Redis password (used by redis pod and connection strings)
REDIS_PASSWORD=RedisStr0ng@Pass

# PHI Encryption Key (used for encrypting PHI data in Redis cache — 32-byte base64)

# IMPORTANT: before first run set this with `openssl rand -base64 32`
PHI_ENCRYPTION_KEY=38VGIU6AeutFdgN+q2cRyvfm6K2UYSWoXJK8qW9C6EA=

# Connection Strings (injected into clinic-api pod via k8s secret)
# NOTE: Use k8s service names (mssql-service, rabbitmq-service, redis-service), not localhost
ConnectionStrings__ClinicDb=Server=mssql-service,1433;Database=ClinicDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;
ConnectionStrings__RabbitMq=amqp://guest:guest@rabbitmq-service:5672
ConnectionStrings__Redis=redis-service:6379,password=RedisStr0ng@Pass,abortConnect=false
