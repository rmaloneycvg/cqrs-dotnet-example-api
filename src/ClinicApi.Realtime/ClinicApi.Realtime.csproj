<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClinicApi.Realtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.41" />
    <PackageReference Include="WolverineFx" Version="6.24.5" />
    <PackageReference Include="WolverineFx.RabbitMQ" Version="6.24.5" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.24.5" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <!-- Reference shared domain events from ClinicApi -->
  <ItemGroup>
    <Compile Include="..\ClinicApi\Domain\Events\DomainEvents.cs" Link="Domain\DomainEvents.cs" />
  </ItemGroup>

</Project>
